# ============================================================
# AI 工作台后端环境变量样例。复制为 apps/server/.env 后填写。
# .env 已被 .gitignore 挡住——**永远不要提交真实密钥**。
# 敏感密钥只认环境变量：代码里没有兜底，缺了就拒启/拒发（这是特性）。
# ============================================================

# 服务监听端口（桌面端默认连 http://127.0.0.1:8787）
PORT=8787

# PostgreSQL 连接串，默认对应 apps/server/docker-compose.yml
DATABASE_URL=postgresql://workbench:workbench@localhost:5432/workbench

# JWT 签名密钥：≥16 位高熵字符串。生成：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# 敏感字段 AES-256-GCM 密钥（phone_enc / messages.content 等）。
# 建议直接放上面生成器输出的 64 位十六进制。
DATA_KEY=

# 手机号哈希用的 pepper（一手机一用户唯一索引的盐）。留空则退回 DATA_KEY。
PHONE_PEPPER=

# 短信模式：
#   开发：SMS_MOCK=1 —— 验证码只写进**服务器日志**，响应里绝不返回验证码
#   生产：SMS_MOCK 不设，且必须配 SMS_HTTP_URL，否则 /auth/sms/send 直接拒绝并说人话
SMS_MOCK=1

# 通用短信通道（POST JSON {phone, code} 到你的网关；接厂商的适配层自己包一层）。生产必填。
SMS_HTTP_URL=

# 运行环境标记（production 时强制检查短信通道配置）
NODE_ENV=development

# ---- 第 6 步：DeepSeek 流式聊天 ----
# API Key **只填在这里**（apps/server/.env）。它绝不出现在前端 / preload / git；
# 不填也不会崩：/chat/stream 会明确回 503 llm_not_configured，桌面提示「未配置模型」。
DEEPSEEK_API_KEY=

# 可选：OpenAI 兼容网关地址（换官方镜像/代理才动）。默认 https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：模型名。默认 deepseek-chat（官方对话模型）；写死在服务端配置，前端不感知
DEEPSEEK_MODEL=deepseek-chat
